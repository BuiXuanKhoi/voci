<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Persistence layer (EF Core + SQLite), port of Sources/Model/{VolarTask,ReminderRecord,
    CompletionLog,ParseCorrection,TaskStore}.swift. References Volar.Core only (stable, already
    green) so this project's build never depends on Volar.Domain's in-progress state — Volar.Domain
    (TaskItem/Recurrence/NLParser) is being built in parallel by a sibling agent and had zero .cs
    files at the time this project was written. See TaskRepository.cs / TaskEntity.cs doc comments
    for the seam left for Opus to wire once Volar.Domain lands (TaskEntity currently plays the
    "TaskItem" role itself rather than depending on a type that didn't exist yet).
  -->
  <ItemGroup>
    <ProjectReference Include="..\Volar.Core\Volar.Core.csproj" />
    <!--
      Wave 3-B (A2, flagged for Opus review): the ONLY exception to this project's "Core only" rule
      above. ReminderRecordRepository.cs implements Volar.Reminders.IReminderRecordStore — that
      interface is fixed (by this wave's own design) to live in Volar.Reminders, so the concrete EF
      Core store over Volar.Data.Entities.ReminderRecordEntity needs this reference to declare that
      it satisfies the interface. No cycle results: Volar.Reminders itself stays Core+Domain-only
      (never references Volar.Data), so Volar.Data -> Volar.Reminders -> {Volar.Core, Volar.Domain}
      remains a DAG.
    -->
    <ProjectReference Include="..\Volar.Reminders\Volar.Reminders.csproj" />

    <!--
      Wave 3-B (Opus review): second sanctioned exception, same ports-and-adapters shape as the
      Volar.Reminders one above. `ISettingsStore` is the port and lives in Volar.Domain;
      JsonFileSettingsStore.cs is its file-backed adapter, so it must be able to declare
      `: ISettingsStore` rather than merely being shape-compatible (A3 left it undeclared because it
      could not edit this csproj). Volar.Domain -> Volar.Core only, so no cycle.
    -->
    <ProjectReference Include="..\Volar.Domain\Volar.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <!--
      Pin explicitly over the vulnerable transitive version (SQLitePCLRaw.lib.e_sqlite3 2.1.11,
      GHSA-2m69-gcr7-jv3q) pulled in by Microsoft.EntityFrameworkCore.Sqlite 10.0.10.
    -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
  </ItemGroup>

</Project>
