<!--
  Metrics.xaml — density spacing + corner radii + hairline thickness, ported from
  Volar/Sources/Design/Theme.swift's `enum Density` (rowPadY/rowGap/sectionGap per case) and the
  corner-radius/hairline-width constants used throughout Glass.swift's `GlassBackground`/
  `volarHairline` (cornerRadius: CGFloat = 12/9, lineWidth: CGFloat = 0.5).

  Default density is "comfy" per Theme.swift's doc comment; exposed as the unprefixed
  VolarRowPadY/VolarRowGap/VolarSectionGap keys so call sites don't need to pick a density
  explicitly, plus per-density keys (Cozy/Comfy/Roomy) for views that want to switch.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============================================================
         Density — cozy / comfy (default) / roomy
         ============================================================ -->

    <!-- Cozy -->
    <x:Double x:Key="VolarRowPadYCozy">7</x:Double>
    <x:Double x:Key="VolarRowGapCozy">3</x:Double>
    <x:Double x:Key="VolarSectionGapCozy">18</x:Double>

    <!-- Comfy (default) -->
    <x:Double x:Key="VolarRowPadYComfy">10</x:Double>
    <x:Double x:Key="VolarRowGapComfy">4</x:Double>
    <x:Double x:Key="VolarSectionGapComfy">22</x:Double>

    <!-- Roomy -->
    <x:Double x:Key="VolarRowPadYRoomy">14</x:Double>
    <x:Double x:Key="VolarRowGapRoomy">6</x:Double>
    <x:Double x:Key="VolarSectionGapRoomy">30</x:Double>

    <!-- Default-density aliases (comfy) — most call sites should use these directly. -->
    <x:Double x:Key="VolarRowPadY">10</x:Double>
    <x:Double x:Key="VolarRowGap">4</x:Double>
    <x:Double x:Key="VolarSectionGap">22</x:Double>

    <!-- ============================================================
         Corner radii + hairline thickness (Glass.swift GlassBackground/volarHairline defaults)
         ============================================================ -->

    <!-- GlassBackground's default cornerRadius (panels/cards). -->
    <x:Double x:Key="VolarCornerRadiusGlass">12</x:Double>
    <!-- volarHairline's default cornerRadius (bare-bordered elements, e.g. task rows). -->
    <x:Double x:Key="VolarCornerRadiusHairline">9</x:Double>
    <!-- Small controls (chips, buttons). -->
    <x:Double x:Key="VolarCornerRadiusSmall">6</x:Double>

    <!-- Both GlassBackground's .stroke(borderColor, lineWidth: 0.5) and volarHairline's default
         lineWidth: CGFloat = 0.5. -->
    <x:Double x:Key="VolarHairlineThickness">0.5</x:Double>

</ResourceDictionary>
