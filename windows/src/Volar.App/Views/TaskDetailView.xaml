<!--
  Views/TaskDetailView.xaml — port of TaskDetailView.swift (views-inventory.md §1.7): task detail
  modal — title/meta row/description(+read-aloud)/Close/Delete/Mark-done. wave4-contract.md §B3.

  HOSTING (frozen decision 5): a full-bleed overlay layer meant to be placed directly inside Stage
  C's MainWindow overlay Grid — this UserControl owns its own scrim + centered card, so Stage C only
  needs to add `<views:TaskDetailView x:Name="..." ViewModel="{x:Bind ...}"/>` as one more overlay
  child, no extra scrim wiring required at the call site.

  CornerRadius/Thickness literals (gotcha — hand-copied, not StaticResource):
    16 = the modal radius (TaskDetailView.swift:32, `.volarGlass(level: .heavy, cornerRadius: 16)`)
         — a one-off value NOT in Metrics.xaml's 12/9/6 set (views-inventory.md §1.7 point 4 flags
         this as the "4th occurrence" across MorningFrog/TaskDetail/TaskBreakdown).
    12  = VolarCornerRadiusGlass (Metrics.xaml) — the description box's `.volarHairline(cornerRadius: 12)`.
    9   = VolarCornerRadiusHairline (Metrics.xaml) — Close button (TaskDetailView.swift:163).
    8   = one-off — Read-description button + Delete/Mark-done buttons' corner radius
          (TaskDetailView.swift:141/163/178/197 all use 8 or 9; 8 specifically for the read button
          and the two action pills below Close, per the Swift literals).
    0.5 = VolarHairlineThickness (Metrics.xaml).
-->
<UserControl
    x:Class="Volar.App.Views.TaskDetailView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Volar.App.Views.Controls">

    <UserControl.Resources>
        <!-- Scrim over the Today view behind this modal — same 0.5 hairline family opacity math
             GlassPanel/Colors.xaml already use elsewhere in this port (black, not white, since this
             sits ON TOP of content rather than being a translucent panel fill). -->
        <SolidColorBrush x:Key="ScrimBrush" Color="Black" Opacity="0.45" />

        <!-- Color.white.opacity(0.06) -> alpha = round(0.06*255) = 15.3 -> 15 = 0x0F
             (TaskDetailView.swift:162, Close button background). -->
        <SolidColorBrush x:Key="White06Brush" Color="#0FFFFFFF" />

        <!-- VolarHigh (#B9705A) @0.12 -> alpha = round(0.12*255) = 30.6 -> 31 = 0x1F
             (TaskDetailView.swift:177, Delete button background). -->
        <SolidColorBrush x:Key="HighBackground012Brush" Color="#1FB9705A" />

        <!-- VolarHigh @0.25 -> alpha = round(0.25*255) = 63.75 -> 64 = 0x40
             (TaskDetailView.swift:181, Delete button border stroke). -->
        <SolidColorBrush x:Key="HighBorder025Brush" Color="#40B9705A" />

        <!-- accentColors.solid.opacity(0.2) (TaskDetailView.swift:144, Read-description button
             border) — live-tracks AccentSolidBrush's mutated Color (ThemeState.SetAccent), same
             binding technique KeyBadge.xaml's AccentStrokeOpacityBrush already uses. -->
        <SolidColorBrush x:Key="AccentBorder02Brush" Color="{Binding Color, Source={StaticResource AccentSolidBrush}}" Opacity="0.2" />

        <!-- Plain pill-button template: Border+ContentPresenter only, no VisualStateManager
             Background override on PointerOver/Pressed — deliberately, so each button's literal
             Background (set per-instance below, matching each Swift button's own explicit fill)
             never gets silently swapped by the stock WinUI Button chrome. Same template shape as
             Views/Controls/GlassPanel.cs's own ControlTemplate (Border + ContentPresenter). -->
        <Style x:Key="PillButtonStyle" TargetType="Button">
            <Setter Property="Padding" Value="14,0" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Background="{StaticResource ScrimBrush}"
        Visibility="{x:Bind controls:RowPresentation.VisibleIfTrue(ViewModel.HasTask), Mode=OneWay}">
        <controls:GlassPanel
            Level="Heavy"
            CornerRadius="16"
            Width="480"
            MinHeight="520"
            MaxHeight="640"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="20">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Header: frog dot + title -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="8">
                    <Ellipse
                        Width="6"
                        Height="6"
                        Fill="{StaticResource VolarHighBrush}"
                        Visibility="{x:Bind controls:RowPresentation.VisibleIfTrue(ViewModel.ShowFrogDot), Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        FontFamily="{StaticResource VolarUiFontFamily}"
                        FontSize="24"
                        FontWeight="Medium"
                        Foreground="{StaticResource VolarTextPriBrush}"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="2"
                        TextWrapping="Wrap" />
                </StackPanel>

                <!-- Meta row: priority dot+label · deadline · duration · Open/Done -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Ellipse Width="6" Height="6" Fill="{x:Bind controls:RowPresentation.PriorityBrush(ViewModel.Priority), Mode=OneWay}" />
                        <TextBlock
                            Text="{x:Bind ViewModel.PriorityLabel, Mode=OneWay}"
                            FontFamily="{StaticResource VolarUiFontFamily}"
                            FontSize="12"
                            FontWeight="Medium"
                            Foreground="{StaticResource VolarTextSecBrush}" />
                    </StackPanel>
                    <TextBlock
                        Text="&#183;"
                        Opacity="0.4"
                        Foreground="{StaticResource VolarTextSecBrush}"
                        Visibility="{x:Bind controls:RowPresentation.VisibleIfTrue(ViewModel.HasDeadline), Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.DeadlineText, Mode=OneWay}"
                        FontFamily="{StaticResource VolarUiFontFamily}"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{StaticResource VolarTextSecBrush}"
                        Visibility="{x:Bind controls:RowPresentation.VisibleIfTrue(ViewModel.HasDeadline), Mode=OneWay}" />
                    <TextBlock
                        Text="&#183;"
                        Opacity="0.4"
                        Foreground="{StaticResource VolarTextSecBrush}"
                        Visibility="{x:Bind controls:RowPresentation.VisibleIfTrue(ViewModel.HasDuration), Mode=OneWay}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.DurationText, Mode=OneWay}"
                        FontFamily="{StaticResource VolarUiFontFamily}"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{StaticResource VolarTextSecBrush}"
                        Visibility="{x:Bind controls:RowPresentation.VisibleIfTrue(ViewModel.HasDuration), Mode=OneWay}" />
                    <TextBlock Text="&#183;" Opacity="0.4" Foreground="{StaticResource VolarTextSecBrush}" />
                    <TextBlock
                        Text="{x:Bind ViewModel.StatusText, Mode=OneWay}"
                        FontFamily="{StaticResource VolarUiFontFamily}"
                        FontSize="12"
                        FontWeight="Medium"
                        Foreground="{StaticResource VolarTextSecBrush}" />
                </StackPanel>

                <!-- Description -->
                <Grid Grid.Row="2" RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        Grid.Row="0"
                        Text="DESCRIPTION"
                        FontFamily="{StaticResource VolarUiFontFamily}"
                        FontSize="11"
                        FontWeight="Medium"
                        CharacterSpacing="70"
                        Foreground="{StaticResource VolarTextMutBrush}" />
                    <Border
                        Grid.Row="1"
                        Background="{StaticResource VolarCardBrush}"
                        BorderBrush="{StaticResource VolarGlassBorderBrush}"
                        BorderThickness="0.5"
                        CornerRadius="12">
                        <ScrollViewer Padding="12" VerticalScrollBarVisibility="Auto">
                            <TextBlock
                                FontFamily="{StaticResource VolarUiFontFamily}"
                                FontSize="14"
                                LineHeight="19"
                                TextWrapping="Wrap"
                                Text="{x:Bind controls:RowPresentation.OrEmpty(ViewModel.DescriptionText), Mode=OneWay}"
                                Foreground="{StaticResource VolarTextSecBrush}"
                                Visibility="{x:Bind controls:RowPresentation.VisibleIfTrue(ViewModel.HasDescription), Mode=OneWay}" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock
                        Grid.Row="1"
                        Margin="12"
                        VerticalAlignment="Top"
                        Text="No description"
                        FontFamily="{StaticResource VolarUiFontFamily}"
                        FontSize="14"
                        Foreground="{StaticResource VolarTextMutBrush}"
                        Opacity="0.7"
                        Visibility="{x:Bind controls:RowPresentation.VisibleIfFalse(ViewModel.HasDescription), Mode=OneWay}" />

                    <Button
                        Grid.Row="2"
                        Style="{StaticResource PillButtonStyle}"
                        Height="30"
                        CornerRadius="8"
                        Background="{StaticResource AccentSurfaceBrush}"
                        BorderBrush="{StaticResource AccentBorder02Brush}"
                        Command="{x:Bind ViewModel.ReadAloudCommand, Mode=OneWay}"
                        AutomationProperties.Name="Read description">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <controls:VolarIcon IconName="Volume" IconSize="13" IconBrush="{StaticResource AccentSolidBrush}" />
                            <TextBlock
                                Text="Read description"
                                FontFamily="{StaticResource VolarUiFontFamily}"
                                FontSize="12"
                                FontWeight="Medium"
                                Foreground="{StaticResource AccentSolidBrush}" />
                        </StackPanel>
                    </Button>
                </Grid>

                <!-- Actions: Close · Delete · [spacer] · Mark done -->
                <Grid Grid.Row="3" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="0"
                        Style="{StaticResource PillButtonStyle}"
                        Height="34"
                        CornerRadius="9"
                        Background="{StaticResource White06Brush}"
                        BorderBrush="{StaticResource VolarGlassBorderBrush}"
                        Command="{x:Bind ViewModel.CloseCommand, Mode=OneWay}">
                        <TextBlock Text="Close" FontFamily="{StaticResource VolarUiFontFamily}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource VolarTextPriBrush}" />
                    </Button>
                    <Button
                        Grid.Column="1"
                        Style="{StaticResource PillButtonStyle}"
                        Height="34"
                        CornerRadius="9"
                        Background="{StaticResource HighBackground012Brush}"
                        BorderBrush="{StaticResource HighBorder025Brush}"
                        Command="{x:Bind ViewModel.DeleteCommand, Mode=OneWay}">
                        <TextBlock Text="Delete" FontFamily="{StaticResource VolarUiFontFamily}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource VolarHighBrush}" />
                    </Button>
                    <Button
                        Grid.Column="3"
                        HorizontalAlignment="Right"
                        Style="{StaticResource PillButtonStyle}"
                        Height="34"
                        Padding="16,0"
                        CornerRadius="9"
                        Background="{StaticResource AccentSolidBrush}"
                        BorderBrush="{StaticResource AccentSolidBrush}"
                        Command="{x:Bind ViewModel.ToggleDoneCommand, Mode=OneWay}">
                        <TextBlock
                            Text="{x:Bind ViewModel.ToggleDoneLabel, Mode=OneWay}"
                            FontFamily="{StaticResource VolarUiFontFamily}"
                            FontSize="13"
                            FontWeight="Medium"
                            Foreground="White" />
                    </Button>
                </Grid>
            </Grid>
        </controls:GlassPanel>
    </Grid>
</UserControl>
