<!--
  Views/SweepView.xaml — port of SweepView.swift (views-inventory.md §1.10): evening sweep batch
  card, sibling of TriageView.xaml (same 520px shell/header/list/footer/glass-level/row-hairline/
  hover shape) but keeps 2 actions (Complete/Skip) instead of 4, and a MONO footer count — the 3
  documented asymmetries (§1.10 point 4) are preserved deliberately, not "fixed" into symmetry.
  wave4-contract.md §B3.

  CornerRadius/Thickness literals (gotcha):
    16 = modal radius (SweepView.swift:45, 7th occurrence per views-inventory.md §1.10 point 4).
    12 = VolarCornerRadiusGlass (Metrics.xaml) — row card.
    8  = one-off — Complete/Skip buttons' corner radius (SweepView.swift:182/197).
    0.5 = VolarHairlineThickness (Metrics.xaml).
-->
<UserControl
    x:Class="Volar.App.Views.SweepView"
    x:Name="RootControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Volar.App.Views.Controls"
    xmlns:domain="using:Volar.Domain">

    <UserControl.Resources>
        <SolidColorBrush x:Key="ScrimBrush" Color="Black" Opacity="0.45" />

        <!-- Color.white.opacity(0.06) -> alpha 0x0F (SweepView.swift:181/196, action button background). -->
        <SolidColorBrush x:Key="White06Brush" Color="#0FFFFFFF" />

        <Style x:Key="ActionButtonStyle" TargetType="Button">
            <Setter Property="Height" Value="28" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="BorderThickness" Value="0.5" />
            <Setter Property="Padding" Value="12,0" />
            <Setter Property="Background" Value="{StaticResource White06Brush}" />
            <Setter Property="BorderBrush" Value="{StaticResource VolarGlassBorderBrush}" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter
                                Content="{TemplateBinding Content}"
                                Padding="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="RowTemplate" x:DataType="domain:TaskItem">
            <Border
                x:Name="RowRoot"
                Margin="0,0,0,8"
                Padding="12"
                CornerRadius="12"
                Background="{StaticResource VolarCardBrush}"
                BorderBrush="{StaticResource VolarGlassBorderBrush}"
                BorderThickness="0.5"
                PointerEntered="OnRowPointerEntered"
                PointerExited="OnRowPointerExited">
                <Grid ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Ellipse Width="5" Height="5" Fill="{x:Bind controls:RowPresentation.PriorityBrush(Priority)}" />
                            <TextBlock
                                Text="{x:Bind Title}"
                                FontFamily="{StaticResource VolarUiFontFamily}"
                                FontSize="13"
                                FontWeight="Medium"
                                Foreground="{StaticResource VolarTextPriBrush}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            Text="{x:Bind controls:RowPresentation.OrEmpty(DurationLabel)}"
                            Visibility="{x:Bind controls:RowPresentation.VisibleIfNotEmpty(DurationLabel)}"
                            FontFamily="{StaticResource VolarMonoFontFamily}"
                            FontSize="11"
                            Foreground="{StaticResource VolarTextMutBrush}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                        <Button
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding ElementName=RootControl, Path=ViewModel.CompleteCommand}"
                            CommandParameter="{x:Bind}"
                            AutomationProperties.Name="{x:Bind controls:RowPresentation.ActionAutomationName('Complete', Title)}">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <controls:VolarIcon IconName="Check" IconSize="10" IconBrush="{StaticResource VolarDoneBrush}" />
                                <TextBlock Text="Complete" FontFamily="{StaticResource VolarUiFontFamily}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource VolarTextPriBrush}" />
                            </StackPanel>
                        </Button>
                        <Button
                            Style="{StaticResource ActionButtonStyle}"
                            Command="{Binding ElementName=RootControl, Path=ViewModel.SkipCommand}"
                            CommandParameter="{x:Bind}"
                            AutomationProperties.Name="{x:Bind controls:RowPresentation.ActionAutomationName('Skip', Title)}">
                            <TextBlock Text="Skip" FontFamily="{StaticResource VolarUiFontFamily}" FontSize="12" FontWeight="Medium" Foreground="{StaticResource VolarTextSecBrush}" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid
        x:Name="Root"
        Background="{StaticResource ScrimBrush}"
        Visibility="{x:Bind controls:RowPresentation.VisibleIfTrue(ViewModel.IsVisible), Mode=OneWay}">
        <controls:GlassPanel
            Level="Heavy"
            CornerRadius="16"
            Width="520"
            MaxHeight="620"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Padding="16">
            <Grid RowSpacing="14">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.Row="0" Spacing="4">
                    <TextBlock
                        Text="EVENING SWEEP"
                        FontFamily="{StaticResource VolarUiFontFamily}"
                        FontSize="11"
                        FontWeight="Medium"
                        CharacterSpacing="70"
                        Foreground="{StaticResource VolarTextMutBrush}" />
                    <TextBlock
                        Text="Let's close out today"
                        FontFamily="{StaticResource VolarUiFontFamily}"
                        FontSize="16"
                        FontWeight="Medium"
                        Foreground="{StaticResource VolarTextPriBrush}" />
                    <TextBlock
                        Text="Quick pass through what's still open. Anything left over just rolls to tomorrow — no harm done."
                        FontFamily="{StaticResource VolarUiFontFamily}"
                        FontSize="12"
                        TextWrapping="Wrap"
                        Foreground="{StaticResource VolarTextSecBrush}" />
                </StackPanel>

                <ListView
                    Grid.Row="1"
                    MaxHeight="420"
                    ItemsSource="{x:Bind ViewModel.Items, Mode=OneWay}"
                    ItemTemplate="{StaticResource RowTemplate}"
                    SelectionMode="None"
                    IsItemClickEnabled="False"
                    Padding="0">
                    <ListView.ItemContainerStyle>
                        <Style TargetType="ListViewItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="MinHeight" Value="0" />
                        </Style>
                    </ListView.ItemContainerStyle>
                </ListView>

                <Grid Grid.Row="2" ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        Text="{x:Bind ViewModel.FooterCountText, Mode=OneWay}"
                        FontFamily="{StaticResource VolarMonoFontFamily}"
                        FontSize="11"
                        Foreground="{StaticResource VolarTextMutBrush}" />
                    <Button
                        Grid.Column="1"
                        Background="Transparent"
                        BorderThickness="0"
                        Padding="14,0"
                        Height="30"
                        Command="{x:Bind ViewModel.DismissCommand, Mode=OneWay}">
                        <TextBlock Text="Done for today" FontFamily="{StaticResource VolarUiFontFamily}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource VolarTextSecBrush}" />
                    </Button>
                </Grid>
            </Grid>
        </controls:GlassPanel>
    </Grid>
</UserControl>
