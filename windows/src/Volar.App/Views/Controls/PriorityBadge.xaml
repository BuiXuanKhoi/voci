<!--
  Views/Controls/PriorityBadge.xaml — port of Components.swift's `PriorityBadge` (lines 40-72):
  dot + High/Medium/Low pill. wave4-contract.md Stage A deliverable 2.

  FROZEN DECISION 14 (wave4-contract.md): port the CURRENT Components.swift, which (post commit
  eb627de) already uses `VolarColor.high`/`.med` tokens consistently for dot AND pill background/
  foreground — the STALE pre-retheme `0xFF6B6B`/`0xFFB347` literals views-inventory.md §1.11
  flagged are already gone from the source read for this port. Nothing to fix; just port faithfully
  and do not resurrect the old literals.

  Capsule shape (SwiftUI `.clipShape(Capsule())`) -> CornerRadius = height/2 = 11 (height is fixed
  22, Components.swift:68) — a one-off literal, same shape math TimeBadge.xaml uses for its
  identical pill. No AppState/accent coupling in this control (Components.swift:41-46 takes no
  `@Environment(AppState.self)` — pure `Priority` parameter).
-->
<UserControl
    x:Class="Volar.App.Views.Controls.PriorityBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border
        x:Name="RootBorder"
        Height="22"
        Padding="9,0"
        CornerRadius="11"
        HorizontalAlignment="Left"
        VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Ellipse x:Name="Dot" Width="6" Height="6" VerticalAlignment="Center" />
            <TextBlock
                x:Name="LabelText"
                FontSize="11.5"
                FontWeight="Medium"
                VerticalAlignment="Center" />
        </StackPanel>
    </Border>
</UserControl>
