<!--
  Views/Controls/KeyBadge.xaml — port of Components.swift's `KeyBadge` (lines 11-38): a
  "Ctrl Alt Space"-style key chip. wave4-contract.md Stage A deliverable 2.

  CornerRadius gotcha (wave4-contract.md "Hard gotchas"): 5 is a one-off literal from
  Components.swift:32/34 (`RoundedRectangle(cornerRadius: 5)`) — it does NOT match any of the 3
  named Metrics.xaml radii (VolarCornerRadiusGlass 12 / Hairline 9 / Small 6), so it is hand-copied
  here rather than bound to a resource, matching the inventory's own note that this file's radius
  is a component-local one-off.

  The 0.5px BorderThickness is VolarHairlineThickness's literal value (same CornerRadius/Thickness
  restriction — StaticResource x:Double cannot back a Thickness property).
-->
<UserControl
    x:Class="Volar.App.Views.Controls.KeyBadge"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <UserControl.Resources>
        <!-- accentColors.solid.opacity(0.33) (Components.swift:35) — a live-updating brush whose
             Color tracks the shared AccentSolidBrush (mutated in place by ThemeState.SetAccent),
             with a separate 0.33 Opacity multiplier so the base color's own alpha is untouched. -->
        <SolidColorBrush x:Key="AccentStrokeOpacityBrush"
                         Color="{Binding Color, Source={StaticResource AccentSolidBrush}}"
                         Opacity="0.33" />
    </UserControl.Resources>
    <Border
        x:Name="RootBorder"
        MinWidth="18"
        MinHeight="18"
        Padding="5,0"
        CornerRadius="5"
        BorderThickness="0.5"
        HorizontalAlignment="Left"
        VerticalAlignment="Center">
        <TextBlock
            x:Name="LabelText"
            FontFamily="{StaticResource VolarMonoFontFamily}"
            FontSize="10.5"
            FontWeight="Medium"
            HorizontalAlignment="Center"
            VerticalAlignment="Center" />
    </Border>
</UserControl>
