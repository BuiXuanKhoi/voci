<!--
  Views/Controls/NotificationBanner.xaml — port of NotificationView.swift (85 lines): in-app
  reminder banner. wave4-contract.md Stage B5; views-inventory.md §1.1.

  GlassPanel Heavy + cornerRadius 14 (one-off, not a Metrics key — NotificationView.swift:57) +
  the one-off tint Color(volar: 0x282828) (views-inventory.md §1.1 point 4: "NOT a named token").
  Width 380 literal (NotificationView.swift:56).

  Action buttons stretch equally (`.frame(maxWidth: .infinity)` per button,
  NotificationView.swift:60-77) — a Grid with 3 star-width columns, not a StackPanel (a horizontal
  StackPanel would size each Button to its own content instead of splitting the row evenly).
-->
<UserControl
    x:Class="Volar.App.Views.Controls.NotificationBanner"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Volar.App.Views.Controls"
    HorizontalAlignment="Right"
    VerticalAlignment="Top"
    Margin="16">

    <UserControl.Resources>
        <!-- accentColors.solid -> accentColors.hover gradient (NotificationView.swift:24) — same
             live-updating "bind a GradientStop.Color to a shared brush's .Color" trick KeyBadge.xaml
             already uses for its accent stroke, so this tile keeps tracking ThemeState.SetAccent's
             in-place brush mutation (frozen decision 9). -->
        <LinearGradientBrush x:Key="IconTileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{Binding Color, Source={StaticResource AccentSolidBrush}}" Offset="0" />
            <GradientStop Color="{Binding Color, Source={StaticResource AccentHoverBrush}}" Offset="1" />
        </LinearGradientBrush>

        <!-- accentColors.solid.opacity(0.27) (NotificationView.swift:75, Reschedule button stroke). -->
        <SolidColorBrush x:Key="AccentStrokeOpacity27Brush" Color="{Binding Color, Source={StaticResource AccentSolidBrush}}" Opacity="0.27" />
    </UserControl.Resources>

    <controls:GlassPanel
        x:Name="RootPanel"
        Level="Heavy"
        CornerRadius="14"
        TintOverlay="#FF282828"
        Width="380"
        Padding="14">
        <StackPanel Spacing="8">
            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Width="38" Height="38" CornerRadius="9" VerticalAlignment="Top" Background="{StaticResource IconTileBrush}">
                    <controls:VolarIcon IconName="Mic" IconSize="20" IconBrush="White" HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Volar" FontSize="13" FontWeight="Medium" Foreground="{StaticResource VolarTextPriBrush}" />
                        <TextBlock Text="· now" FontSize="11" Foreground="{StaticResource VolarTextSecBrush}" />
                    </StackPanel>
                    <TextBlock x:Name="ComingUpText" FontSize="13" FontWeight="Medium" Foreground="{StaticResource VolarTextPriBrush}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis" />
                    <TextBlock x:Name="TimingText" FontSize="12" Foreground="{StaticResource VolarTextSecBrush}" />
                </StackPanel>
            </Grid>

            <Grid ColumnSpacing="6" Margin="0,2,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Done / Snooze — not solid (NotificationView.swift:71: VolarColor.veil(0.08)
                     background -> #1494B2E0, border VolarColor.veil(0.06) -> #0F94B2E0). -->
                <Button Grid.Column="0" x:Name="DoneButton" Click="OnDoneClick" Height="28" Padding="0" CornerRadius="8" Background="#1494B2E0" BorderBrush="#0F94B2E0" BorderThickness="0.5">
                    <TextBlock Text="Done" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource VolarTextPriBrush}" />
                </Button>
                <Button Grid.Column="1" x:Name="SnoozeButton" Click="OnSnoozeClick" Height="28" Padding="0" CornerRadius="8" Background="#1494B2E0" BorderBrush="#0F94B2E0" BorderThickness="0.5">
                    <TextBlock Text="Snooze 10 min" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource VolarTextPriBrush}" />
                </Button>
                <!-- Reschedule — solid (NotificationView.swift:71: accentColors.surface background,
                     accentColors.solid text/border). -->
                <Button Grid.Column="2" x:Name="RescheduleButton" Click="OnRescheduleClick" Height="28" Padding="0" CornerRadius="8" Background="{StaticResource AccentSurfaceBrush}" BorderBrush="{StaticResource AccentStrokeOpacity27Brush}" BorderThickness="0.5">
                    <TextBlock Text="Reschedule" FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource AccentSolidBrush}" />
                </Button>
            </Grid>
        </StackPanel>
    </controls:GlassPanel>
</UserControl>
