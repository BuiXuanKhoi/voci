<!--
  Views/Controls/TaskRowControl.xaml — port of TaskRow.swift (views-inventory.md §1.4): the single
  task row reused inside TodayView's "Later"/"Completed" drawers. wave4-contract.md Stage B1
  deliverable. DataContext is a ViewModels.TaskRowViewModel — set implicitly by whatever ItemsControl
  hosts this template (Later/Completed drawers in TodayView.xaml), no explicit binding needed at the
  call site.

  Follows the SAME "named elements + code-behind UpdateVisual()" pattern Stage A's
  KeyBadge/PriorityBadge/TimeBadge/ToolButton/SectionHeader already established (see those files) —
  deliberately NOT classic {Binding ...} markup, for consistency with the rest of this control
  library and because several values (priority dot color, hover/active background swap, done-state
  strikethrough) need imperative logic classic Binding+Converters would only obscure.

  CornerRadius 9 = VolarCornerRadiusHairline (Metrics.xaml) — literal per the CornerRadius/Thickness
  gotcha (StaticResource x:Double cannot back a CornerRadius-typed property). BorderThickness 0.5 =
  VolarHairlineThickness, same gotcha. Checkbox circle 17x17, priority/frog dots 5x5 — all literals
  matching TaskRow.swift's own literals (110/129/142).
-->
<UserControl
    x:Class="Volar.App.Views.Controls.TaskRowControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Volar.App.Views.Controls">
    <UserControl.Resources>
        <!-- accentColors.solid.opacity(0.25) (TaskRow.swift:49) — active-row border, live-tracking
             the shared AccentSolidBrush (decision 9: mutated in place by ThemeState.SetAccent). -->
        <SolidColorBrush x:Key="ActiveBorderBrush"
                         Color="{Binding Color, Source={StaticResource AccentSolidBrush}}"
                         Opacity="0.25" />
        <!-- accentColors.solid.opacity(0.19) (TaskRow.swift:73) — the extra inner hairline while
             active, mirroring the prototype's inset boxShadow. -->
        <SolidColorBrush x:Key="ActiveInnerBorderBrush"
                         Color="{Binding Color, Source={StaticResource AccentSolidBrush}}"
                         Opacity="0.19" />
    </UserControl.Resources>

    <Border
        x:Name="RootBorder"
        CornerRadius="9"
        BorderThickness="0.5"
        PointerEntered="OnPointerEntered"
        PointerExited="OnPointerExited"
        PointerPressed="OnPointerPressed"
        PointerReleased="OnPointerReleased"
        PointerCanceled="OnPointerReleased"
        Tapped="OnRowTapped">
        <Border.RenderTransform>
            <ScaleTransform x:Name="PressScale" ScaleX="1" ScaleY="1" CenterX="0" CenterY="0" />
        </Border.RenderTransform>
        <Border.ContextFlyout>
            <MenuFlyout>
                <MenuFlyoutItem x:Name="BreakdownMenuItem" Text="Break down into steps…" Click="OnBreakdownClick" />
                <MenuFlyoutItem x:Name="ToggleDoneMenuItem" Text="Mark done" Click="OnToggleDoneClick" />
                <MenuFlyoutSeparator />
                <MenuFlyoutItem
                    x:Name="DeleteMenuItem"
                    Text="Delete"
                    Click="OnDeleteClick"
                    Foreground="{StaticResource VolarDestructBrush}" />
            </MenuFlyout>
        </Border.ContextFlyout>

        <Grid Padding="12,0" ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Checkbox — its own Button so it consumes its own tap before the row's Tapped fires
                 (mirrors TaskRow.swift:81-91's documented "checkbox consumes its own tap first"). -->
            <Button
                x:Name="CheckboxButton"
                Grid.Column="0"
                Width="17"
                Height="17"
                Padding="0"
                Margin="0,1,0,0"
                BorderThickness="0"
                Background="Transparent"
                VerticalAlignment="Top"
                Click="OnCheckboxClick">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid Background="{TemplateBinding Background}">
                            <ContentPresenter Content="{TemplateBinding Content}" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
                <Grid Width="17" Height="17">
                    <Ellipse x:Name="CheckboxRing" Width="17" Height="17" StrokeThickness="1.5" />
                    <Ellipse x:Name="CheckboxFill" Width="17" Height="17" />
                    <controls:VolarIcon
                        x:Name="CheckIcon"
                        IconName="Check"
                        IconSize="11"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center" />
                </Grid>
            </Button>

            <!-- Title + subrow -->
            <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="7">
                    <Ellipse x:Name="FrogDot" Width="5" Height="5" Fill="{StaticResource VolarHighBrush}" />
                    <TextBlock
                        x:Name="TitleText"
                        FontFamily="{StaticResource VolarUiFontFamily}"
                        FontSize="13"
                        TextTrimming="CharacterEllipsis"
                        MaxLines="1" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Ellipse x:Name="PriorityDot" Width="5" Height="5" />
                    <TextBlock x:Name="PriorityLabelText" FontSize="11" Foreground="{StaticResource VolarTextSecBrush}" />
                    <TextBlock x:Name="DurationSeparator" Text="·" FontSize="11" Opacity="0.4" Foreground="{StaticResource VolarTextSecBrush}" />
                    <TextBlock x:Name="DurationText" FontSize="11" Foreground="{StaticResource VolarTextSecBrush}" />
                    <TextBlock x:Name="FrogSeparator" Text="·" FontSize="11" Opacity="0.4" Foreground="{StaticResource VolarTextSecBrush}" />
                    <TextBlock
                        x:Name="FrogLabelText"
                        Text="Frog"
                        FontSize="11"
                        FontWeight="Medium"
                        Foreground="{StaticResource VolarHighBrush}" />
                </StackPanel>
            </StackPanel>

            <!-- Trailing: TimeBadge (open tasks) OR muted raw time text (done tasks) -->
            <Grid Grid.Column="2" VerticalAlignment="Center">
                <controls:TimeBadge x:Name="TrailingTimeBadge" />
                <TextBlock x:Name="TrailingDoneTimeText" FontSize="11" Foreground="{StaticResource VolarTextMutBrush}" />
            </Grid>
        </Grid>
    </Border>
</UserControl>
