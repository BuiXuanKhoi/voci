<!--
  Views/OnboardingView.xaml — B4 (Settings + Onboarding), Wave 4. Port of
  Volar/Sources/Views/OnboardingView.swift (302 lines) — see
  specs/003-windows-port/views-inventory.md SS1.13 and wave4-contract.md frozen decision 8 (step 2
  "Allow microphone" is informational-only on Windows, opening ms-settings:privacy-microphone; no
  permission API call).

  HOSTING: like SettingsView, this is a full-window overlay inside MainWindow (decision 5) rather
  than a separate Window — Swift's version IS a real, separate window (`VolarApp.swift`'s onboarding
  scene has "no faux titlebar" per that file's own header, since a real window already has real
  traffic lights); this port instead renders as MainWindow's own content until
  <see cref="OnboardingView.Finished"/> fires, since a single-MainWindow shell has nothing else to
  show yet at first run anyway.

  The 3 step panels (hotkey intro / mic permission / try-it) are declared statically here (unlike
  SettingsView's programmatic rows) because — unlike Settings' 6 data-driven tabs — each step's
  content is fixed marketing/instructional copy with no per-item loops, closer to a straight port of
  Swift's own `stepOne`/`stepTwo`/`stepThree` computed properties. `StepHost` is what
  OnboardingView.xaml.cs crossfades between the 3 panels below (Storyboard Opacity, not a raw
  Visibility swap, per Swift's `withAnimation { step = N }`).

  CornerRadius/Thickness gotcha: 22 (icon tiles), 11 (primary buttons), 14 (step-3 key chip), 12
  (step-3 "try saying" box) are hand-copied literals — the exact 4 one-offs views-inventory.md
  SS1.13 point 4 calls out ("this view alone introduces 22pt icon-tile radius and 11pt button
  radius, neither matching any existing Metrics key").
-->
<UserControl
    x:Class="Volar.App.Views.OnboardingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="using:Volar.App.Views.Controls">
    <Grid x:Name="RootGrid" Background="{StaticResource VolarBgBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentControl
                x:Name="StepHost"
                Grid.Row="0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                HorizontalContentAlignment="Left"
                MaxWidth="460"
                Margin="40" />

            <Grid Grid.Row="1" Padding="24,14">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Rectangle VerticalAlignment="Top" Height="0.5" Fill="{StaticResource VolarBorderBrush}" />
                <TextBlock
                    x:Name="FooterStepText"
                    Grid.Column="0"
                    FontSize="12"
                    Foreground="{StaticResource VolarTextMutBrush}" />
                <TextBlock
                    Grid.Column="1"
                    Text="volar.app"
                    FontSize="12"
                    Foreground="{StaticResource VolarTextSecBrush}" />
            </Grid>
        </Grid>

        <StackPanel
            x:Name="StepDotsPanel"
            Orientation="Horizontal"
            Spacing="6"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Margin="0,20,24,0" />
    </Grid>
</UserControl>
