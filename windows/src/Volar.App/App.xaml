<Application
    x:Class="Volar.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    RequestedTheme="Dark">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
                <!-- Studio Dark design-token port (1:1 with Volar/Sources/Design/Theme.swift &
                     Glass.swift) — dark-only, no light variant. Order matters: later
                     dictionaries (Typography/Glass) reference StaticResource brushes/colors
                     defined in Colors.xaml, so it must be merged first. -->
                <ResourceDictionary Source="Theme/Colors.xaml" />
                <ResourceDictionary Source="Theme/Accents.xaml" />
                <ResourceDictionary Source="Theme/Typography.xaml" />
                <ResourceDictionary Source="Theme/Metrics.xaml" />
                <ResourceDictionary Source="Theme/Glass.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
